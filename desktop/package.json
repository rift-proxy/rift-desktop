{
  "name": "@rift/desktop",
  "version": "1.1.2",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1",
    "build-storybook": "storybook build",
    "test": "vitest run --project unit",
    "test:stories": "vitest run --project storybook",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write src *.ts .storybook",
    "format:check": "prettier --check src *.ts .storybook",
    "test:e2e": "playwright test --grep-invert visual",
    "mutate": "stryker run"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.3.1",
    "@tauri-apps/api": "^2.12.1",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.0",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-vitest": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "cross-spawn": "^7.0.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.0.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.9.8",
    "storybook": "10.6.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  }
}
